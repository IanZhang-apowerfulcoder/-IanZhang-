{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "7.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "workflow_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "learner_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_name": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "context_refs": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ContextReference",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref_type": {
            "type": "string"
          },
          "ref_id": {
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ref_type",
          "ref_id"
        ]
      },
      "minItems": 0
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "learner_snapshot": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "LearnerSnapshot",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_snapshot_id": {
          "type": "string",
          "format": "uuid"
        },
        "background": {
          "type": "object",
          "additionalProperties": true
        },
        "learning_goals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "preferences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "mastery_items": {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "MasteryItem",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "knowledge_node_id": {
                "type": "string"
              },
              "mastery_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "title": "EvidenceReference",
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "evidence_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "knowledge_node_id": {
                      "type": "string"
                    },
                    "claim_scope": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "evidence_id",
                    "knowledge_node_id"
                  ]
                },
                "minItems": 0
              }
            },
            "required": [
              "knowledge_node_id",
              "mastery_score",
              "confidence",
              "evidence_refs"
            ]
          },
          "minItems": 0
        },
        "risk_flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      },
      "required": [
        "profile_snapshot_id",
        "background",
        "learning_goals",
        "preferences",
        "mastery_items",
        "risk_flags"
      ]
    },
    "path_step": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "PathStep",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "type": "string"
        },
        "knowledge_node_id": {
          "type": "string"
        },
        "sequence_no": {
          "type": "integer",
          "minimum": 1
        },
        "difficulty_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "resource_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "explanation",
              "practice",
              "quiz",
              "case_study"
            ]
          },
          "minItems": 0
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "prerequisite_node_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      },
      "required": [
        "step_id",
        "knowledge_node_id",
        "sequence_no",
        "difficulty_level",
        "resource_types",
        "success_criteria",
        "prerequisite_node_ids"
      ]
    },
    "evidence_bundle": {
      "type": "object",
      "additionalProperties": true
    },
    "resource_requirements": {
      "type": "object",
      "additionalProperties": true
    },
    "revision_instructions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "workflow_run_id",
    "session_id",
    "organization_id",
    "learner_id",
    "agent_name",
    "task_type",
    "context_refs",
    "constraints",
    "requested_at",
    "learner_snapshot",
    "path_step",
    "evidence_bundle",
    "resource_requirements",
    "revision_instructions"
  ]
}
