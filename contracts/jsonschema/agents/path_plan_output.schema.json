{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PathPlanOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "7.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "needs_input",
        "degraded"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoning_summary": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "primary_path": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "PathStep",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "step_id": {
            "type": "string"
          },
          "knowledge_node_id": {
            "type": "string"
          },
          "sequence_no": {
            "type": "integer",
            "minimum": 1
          },
          "difficulty_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "resource_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "explanation",
                "practice",
                "quiz",
                "case_study"
              ]
            },
            "minItems": 0
          },
          "success_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "prerequisite_node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          }
        },
        "required": [
          "step_id",
          "knowledge_node_id",
          "sequence_no",
          "difficulty_level",
          "resource_types",
          "success_criteria",
          "prerequisite_node_ids"
        ]
      },
      "minItems": 1
    },
    "alternative_paths": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "PathStep",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "step_id": {
              "type": "string"
            },
            "knowledge_node_id": {
              "type": "string"
            },
            "sequence_no": {
              "type": "integer",
              "minimum": 1
            },
            "difficulty_level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "resource_types": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "explanation",
                  "practice",
                  "quiz",
                  "case_study"
                ]
              },
              "minItems": 0
            },
            "success_criteria": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            },
            "prerequisite_node_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            }
          },
          "required": [
            "step_id",
            "knowledge_node_id",
            "sequence_no",
            "difficulty_level",
            "resource_types",
            "success_criteria",
            "prerequisite_node_ids"
          ]
        },
        "minItems": 0
      },
      "minItems": 0
    },
    "path_risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "EvidenceReference",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "format": "uuid"
          },
          "knowledge_node_id": {
            "type": "string"
          },
          "claim_scope": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "evidence_id",
          "knowledge_node_id"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "agent_name",
    "status",
    "confidence",
    "reasoning_summary",
    "warnings",
    "requires_human_review",
    "completed_at",
    "plan_id",
    "primary_path",
    "alternative_paths",
    "path_risks",
    "evidence"
  ]
}
