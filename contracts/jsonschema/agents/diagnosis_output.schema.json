{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiagnosisOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "7.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "needs_input",
        "degraded"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoning_summary": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "mastered_nodes": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "MasteryItem",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "knowledge_node_id": {
            "type": "string"
          },
          "mastery_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "EvidenceReference",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "knowledge_node_id": {
                  "type": "string"
                },
                "claim_scope": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "evidence_id",
                "knowledge_node_id"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "knowledge_node_id",
          "mastery_score",
          "confidence",
          "evidence_refs"
        ]
      },
      "minItems": 0
    },
    "weak_nodes": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "MasteryItem",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "knowledge_node_id": {
            "type": "string"
          },
          "mastery_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "EvidenceReference",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "knowledge_node_id": {
                  "type": "string"
                },
                "claim_scope": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "evidence_id",
                "knowledge_node_id"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "knowledge_node_id",
          "mastery_score",
          "confidence",
          "evidence_refs"
        ]
      },
      "minItems": 0
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Misconception",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "knowledge_node_id": {
            "type": "string"
          },
          "error_code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "EvidenceReference",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "knowledge_node_id": {
                  "type": "string"
                },
                "claim_scope": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "evidence_id",
                "knowledge_node_id"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "knowledge_node_id",
          "error_code",
          "description",
          "evidence_refs"
        ]
      },
      "minItems": 0
    },
    "learning_needs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "recommended_focus_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "EvidenceReference",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "format": "uuid"
          },
          "knowledge_node_id": {
            "type": "string"
          },
          "claim_scope": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "evidence_id",
          "knowledge_node_id"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "agent_name",
    "status",
    "confidence",
    "reasoning_summary",
    "warnings",
    "requires_human_review",
    "completed_at",
    "mastered_nodes",
    "weak_nodes",
    "misconceptions",
    "learning_needs",
    "recommended_focus_nodes",
    "evidence"
  ]
}
