{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArbitrationOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "7.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "needs_input",
        "degraded"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoning_summary": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "publish_resource",
        "request_revision",
        "retrieve_more",
        "replan_path",
        "deliver_assessment",
        "update_profile",
        "advance",
        "reinforce",
        "remediate",
        "human_review",
        "refuse",
        "fail"
      ]
    },
    "selected_proposal_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 0
    },
    "rejected_proposal_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 0
    },
    "supporting_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 0
    },
    "next_state": {
      "type": "string"
    },
    "action_payload": {
      "type": "object",
      "additionalProperties": true
    },
    "decision_reason_summary": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "agent_name",
    "status",
    "confidence",
    "reasoning_summary",
    "warnings",
    "requires_human_review",
    "completed_at",
    "decision_id",
    "action_type",
    "selected_proposal_ids",
    "rejected_proposal_ids",
    "supporting_evidence_ids",
    "next_state",
    "action_payload",
    "decision_reason_summary"
  ]
}
