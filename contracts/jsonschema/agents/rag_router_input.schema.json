{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RagRouterInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "7.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "workflow_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "learner_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_name": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "context_refs": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ContextReference",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref_type": {
            "type": "string"
          },
          "ref_id": {
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ref_type",
          "ref_id"
        ]
      },
      "minItems": 0
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "query_text": {
      "type": "string",
      "minLength": 1
    },
    "query_task_type": {
      "type": "string",
      "enum": [
        "learning_question",
        "resource_generation",
        "assessment_generation",
        "diagnosis_support",
        "path_support",
        "review_support"
      ]
    },
    "learner_profile_summary": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "LearnerSnapshot",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_snapshot_id": {
          "type": "string",
          "format": "uuid"
        },
        "background": {
          "type": "object",
          "additionalProperties": true
        },
        "learning_goals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "preferences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "mastery_items": {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "MasteryItem",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "knowledge_node_id": {
                "type": "string"
              },
              "mastery_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "title": "EvidenceReference",
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "evidence_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "knowledge_node_id": {
                      "type": "string"
                    },
                    "claim_scope": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "evidence_id",
                    "knowledge_node_id"
                  ]
                },
                "minItems": 0
              }
            },
            "required": [
              "knowledge_node_id",
              "mastery_score",
              "confidence",
              "evidence_refs"
            ]
          },
          "minItems": 0
        },
        "risk_flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      },
      "required": [
        "profile_snapshot_id",
        "background",
        "learning_goals",
        "preferences",
        "mastery_items",
        "risk_flags"
      ]
    },
    "target_knowledge_node_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "knowledge_base_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "requested_resource_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "router_constraints": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "RouterConstraints",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_difficulty_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "max_parallel_strategies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "trusted_only": {
          "type": "boolean"
        }
      },
      "required": [
        "max_difficulty_level",
        "max_steps",
        "max_retries",
        "max_parallel_strategies",
        "trusted_only"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "workflow_run_id",
    "session_id",
    "organization_id",
    "learner_id",
    "agent_name",
    "task_type",
    "context_refs",
    "constraints",
    "requested_at",
    "query_text",
    "query_task_type",
    "learner_profile_summary",
    "target_knowledge_node_ids",
    "knowledge_base_version_id",
    "risk_level",
    "requested_resource_types",
    "router_constraints"
  ]
}
