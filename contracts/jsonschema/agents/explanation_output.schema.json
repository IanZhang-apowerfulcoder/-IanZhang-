{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExplanationOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "7.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "needs_input",
        "degraded"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoning_summary": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string"
    },
    "learning_objectives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "sections": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ExplanationSection",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "heading": {
            "type": "string"
          },
          "body_markdown": {
            "type": "string"
          },
          "claims": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "GroundedClaim",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claim_id": {
                  "type": "string"
                },
                "claim_text": {
                  "type": "string"
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "claim_id",
                "claim_text",
                "evidence_ids"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "heading",
          "body_markdown",
          "claims"
        ]
      },
      "minItems": 1
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "EvidenceReference",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "format": "uuid"
          },
          "knowledge_node_id": {
            "type": "string"
          },
          "claim_scope": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "evidence_id",
          "knowledge_node_id"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "agent_name",
    "status",
    "confidence",
    "reasoning_summary",
    "warnings",
    "requires_human_review",
    "completed_at",
    "title",
    "learning_objectives",
    "sections",
    "examples",
    "evidence"
  ]
}
