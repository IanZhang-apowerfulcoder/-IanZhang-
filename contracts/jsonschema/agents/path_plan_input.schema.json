{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PathPlanInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "7.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "workflow_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "learner_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_name": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "context_refs": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ContextReference",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref_type": {
            "type": "string"
          },
          "ref_id": {
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ref_type",
          "ref_id"
        ]
      },
      "minItems": 0
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "diagnosis_output": {
      "type": "object",
      "additionalProperties": true
    },
    "knowledge_graph_context": {
      "type": "object",
      "additionalProperties": true
    },
    "time_budget_minutes": {
      "type": "integer",
      "minimum": 10
    },
    "target_goal": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "workflow_run_id",
    "session_id",
    "organization_id",
    "learner_id",
    "agent_name",
    "task_type",
    "context_refs",
    "constraints",
    "requested_at",
    "diagnosis_output",
    "knowledge_graph_context",
    "time_budget_minutes",
    "target_goal"
  ]
}
