{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "7.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "needs_input",
        "degraded"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoning_summary": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "resource_draft_id": {
      "type": "string",
      "format": "uuid"
    },
    "resource_title": {
      "type": "string"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "learning_package",
        "grounded_answer"
      ]
    },
    "difficulty_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "personalization_reason": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ResourceSection",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "section_type": {
            "type": "string",
            "enum": [
              "explanation",
              "practice",
              "quiz",
              "summary",
              "references"
            ]
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "object",
            "additionalProperties": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 0
          }
        },
        "required": [
          "section_type",
          "title",
          "content",
          "evidence_ids"
        ]
      },
      "minItems": 1
    },
    "coverage_knowledge_node_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "all_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 1
    },
    "parallel_branch_run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 0
    },
    "revision_no": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "agent_name",
    "status",
    "confidence",
    "reasoning_summary",
    "warnings",
    "requires_human_review",
    "completed_at",
    "resource_draft_id",
    "resource_title",
    "resource_type",
    "difficulty_level",
    "personalization_reason",
    "sections",
    "coverage_knowledge_node_ids",
    "all_evidence_ids",
    "parallel_branch_run_ids",
    "revision_no"
  ]
}
