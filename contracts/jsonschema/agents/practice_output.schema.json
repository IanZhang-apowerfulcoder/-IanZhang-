{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PracticeOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "7.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "needs_input",
        "degraded"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoning_summary": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "PracticeStep",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "step_no": {
            "type": "integer",
            "minimum": 1
          },
          "instruction": {
            "type": "string"
          },
          "expected_result": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 0
          }
        },
        "required": [
          "step_no",
          "instruction",
          "expected_result",
          "evidence_ids"
        ]
      },
      "minItems": 1
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "safety_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "EvidenceReference",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "format": "uuid"
          },
          "knowledge_node_id": {
            "type": "string"
          },
          "claim_scope": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "evidence_id",
          "knowledge_node_id"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "agent_name",
    "status",
    "confidence",
    "reasoning_summary",
    "warnings",
    "requires_human_review",
    "completed_at",
    "title",
    "scenario",
    "steps",
    "deliverables",
    "acceptance_criteria",
    "safety_notes",
    "evidence"
  ]
}
