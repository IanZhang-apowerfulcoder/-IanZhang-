{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfileUpdateResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "learner_id": {
      "type": "string",
      "format": "uuid"
    },
    "new_profile_snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "profile_version_no": {
      "type": "integer",
      "minimum": 1
    },
    "applied_updates": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "MasteryItem",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "knowledge_node_id": {
            "type": "string"
          },
          "mastery_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "EvidenceReference",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "knowledge_node_id": {
                  "type": "string"
                },
                "claim_scope": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "evidence_id",
                "knowledge_node_id"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "knowledge_node_id",
          "mastery_score",
          "confidence",
          "evidence_refs"
        ]
      },
      "minItems": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "learner_id",
    "new_profile_snapshot_id",
    "profile_version_no",
    "applied_updates",
    "created_at"
  ]
}
