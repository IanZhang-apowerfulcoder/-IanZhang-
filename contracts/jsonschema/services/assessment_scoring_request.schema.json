{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssessmentScoringRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "answers": {
      "type": "object",
      "additionalProperties": true
    },
    "rubric_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "assessment_id",
    "attempt_id",
    "answers",
    "rubric_id"
  ]
}
