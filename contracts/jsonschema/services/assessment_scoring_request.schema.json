{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "测评评分请求",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt_id",
    "assessment_id",
    "answers",
    "answer_key_reference_id"
  ],
  "properties": {
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "assessment_id": {
      "type": "string",
      "format": "uuid"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "answer_key_reference_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
