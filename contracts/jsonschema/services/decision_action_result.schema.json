{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionActionResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "applied",
        "duplicate",
        "rejected"
      ]
    },
    "reference_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "decision_id",
    "status",
    "reference_ids",
    "created_at"
  ]
}
