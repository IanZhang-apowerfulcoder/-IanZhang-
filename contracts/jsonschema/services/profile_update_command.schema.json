{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "画像更新命令",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "learner_id",
    "base_profile_snapshot_id",
    "base_profile_version_no",
    "mastery_delta_by_knowledge_node",
    "derived_from_decision_cycle_id"
  ],
  "properties": {
    "learner_id": {
      "type": "string",
      "format": "uuid"
    },
    "base_profile_snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "base_profile_version_no": {
      "type": "integer",
      "minimum": 1
    },
    "mastery_delta_by_knowledge_node": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      }
    },
    "derived_from_decision_cycle_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
