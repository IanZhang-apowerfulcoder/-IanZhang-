{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfileUpdateCommand",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "learner_id": {
      "type": "string",
      "format": "uuid"
    },
    "base_profile_snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "mastery_updates": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "MasteryItem",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "knowledge_node_id": {
            "type": "string"
          },
          "mastery_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "EvidenceReference",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "knowledge_node_id": {
                  "type": "string"
                },
                "claim_scope": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "evidence_id",
                "knowledge_node_id"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "knowledge_node_id",
          "mastery_score",
          "confidence",
          "evidence_refs"
        ]
      },
      "minItems": 0
    },
    "reason_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "decision_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "learner_id",
    "base_profile_snapshot_id",
    "mastery_updates",
    "reason_refs",
    "decision_id"
  ]
}
