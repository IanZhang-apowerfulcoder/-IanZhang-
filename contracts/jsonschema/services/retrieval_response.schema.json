{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetrievalResponse",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "retrieval_request_id": {
      "type": "string",
      "format": "uuid"
    },
    "retrieval_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "knowledge_base_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "query_analysis": {
      "$ref": "query_analysis.schema.json"
    },
    "evidence_bundle": {
      "$ref": "evidence_bundle.schema.json"
    },
    "sufficiency": {
      "$ref": "evidence_sufficiency.schema.json"
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "retrieval_request_id",
    "retrieval_run_id",
    "knowledge_base_version_id",
    "query_analysis",
    "evidence_bundle",
    "sufficiency",
    "latency_ms"
  ]
}
