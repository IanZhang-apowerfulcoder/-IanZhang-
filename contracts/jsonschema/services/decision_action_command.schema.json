{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionActionCommand",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "action_type": {
      "type": "string"
    },
    "action_payload": {
      "type": "object",
      "additionalProperties": true
    },
    "idempotency_key": {
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "action_type",
    "action_payload",
    "idempotency_key"
  ]
}
