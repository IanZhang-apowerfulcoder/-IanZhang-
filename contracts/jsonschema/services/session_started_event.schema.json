{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionStartedEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "workflow_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "learner_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "session_id",
    "workflow_run_id",
    "learner_id",
    "created_at"
  ]
}
