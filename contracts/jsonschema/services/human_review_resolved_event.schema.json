{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "人工审核完成事件",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "human_review_task_id",
    "decision_cycle_id",
    "resolution_code",
    "resolved_by_user_id",
    "occurred_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "human_review_task_id": {
      "type": "string",
      "format": "uuid"
    },
    "decision_cycle_id": {
      "type": "string",
      "format": "uuid"
    },
    "resolution_code": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "revise",
        "continue"
      ]
    },
    "resolved_by_user_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
