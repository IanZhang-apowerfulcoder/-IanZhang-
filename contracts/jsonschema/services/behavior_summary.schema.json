{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BehaviorSummary",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "learner_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "minItems": 0
    },
    "summary": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "learner_id",
    "session_id",
    "events",
    "summary"
  ]
}
