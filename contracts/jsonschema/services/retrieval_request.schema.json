{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetrievalRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "retrieval_request_id": {
      "type": "string",
      "format": "uuid"
    },
    "knowledge_base_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "query_text": {
      "type": "string",
      "minLength": 1
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "filters": {
      "type": "object",
      "additionalProperties": true
    },
    "requested_mode": {
      "type": "string",
      "enum": [
        "compatible",
        "adaptive"
      ]
    }
  },
  "required": [
    "retrieval_request_id",
    "knowledge_base_version_id",
    "query_text",
    "top_k",
    "filters",
    "requested_mode"
  ]
}
