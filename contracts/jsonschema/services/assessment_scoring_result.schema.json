{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "测评评分结果",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt_id",
    "score_ratio",
    "error_type_codes",
    "mastery_delta_by_knowledge_node"
  ],
  "properties": {
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "score_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "error_type_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mastery_delta_by_knowledge_node": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      }
    }
  }
}
