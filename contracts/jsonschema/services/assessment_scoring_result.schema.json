{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssessmentScoringResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "score_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "item_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "minItems": 0
    },
    "feedback": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    }
  },
  "required": [
    "attempt_id",
    "score_ratio",
    "item_results",
    "feedback"
  ]
}
