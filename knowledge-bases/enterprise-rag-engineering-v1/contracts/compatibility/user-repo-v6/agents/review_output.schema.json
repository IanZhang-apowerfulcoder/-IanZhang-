{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "审核纠偏智能体输出",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "proposal_id",
    "reviewed_proposal_id",
    "review_result",
    "overall_score",
    "checks",
    "issues",
    "repair_action",
    "repair_instructions",
    "confidence",
    "requires_human_review"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "format": "uuid"
    },
    "proposal_id": {
      "type": "string",
      "format": "uuid"
    },
    "reviewed_proposal_id": {
      "type": "string",
      "format": "uuid"
    },
    "review_result": {
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "needs_revision",
        "human_required"
      ]
    },
    "overall_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_valid",
        "evidence_supported",
        "factual_consistent",
        "no_conflict",
        "answer_verifiable"
      ],
      "properties": {
        "schema_valid": {
          "type": "boolean"
        },
        "evidence_supported": {
          "type": "boolean"
        },
        "factual_consistent": {
          "type": "boolean"
        },
        "no_conflict": {
          "type": "boolean"
        },
        "answer_verifiable": {
          "type": "boolean"
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_type",
          "severity",
          "location",
          "message"
        ],
        "properties": {
          "issue_type": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "blocking"
            ]
          },
          "location": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "repair_action": {
      "type": "string",
      "enum": [
        "none",
        "regenerate",
        "retrieve_more_evidence",
        "rerun_diagnosis",
        "replan_path",
        "human_review"
      ]
    },
    "repair_instructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_human_review": {
      "type": "boolean"
    }
  }
}
