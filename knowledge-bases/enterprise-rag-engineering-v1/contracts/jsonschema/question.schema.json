{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "question_id",
    "knowledge_node_id",
    "question_type",
    "difficulty_level",
    "stem",
    "correct_answer",
    "score_points",
    "evidence_ids"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "format": "uuid"
    },
    "knowledge_node_id": {
      "type": "string"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "single_choice",
        "multiple_choice",
        "true_false",
        "short_answer",
        "code"
      ]
    },
    "difficulty_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "stem": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1
    }
  }
}
