{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Domain Pack",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "domain_pack_id",
    "slug",
    "version",
    "name_zh",
    "knowledge_base_version_id",
    "quality_targets"
  ],
  "properties": {
    "domain_pack_id": {
      "type": "string",
      "format": "uuid"
    },
    "slug": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "name_zh": {
      "type": "string"
    },
    "knowledge_base_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "quality_targets": {
      "type": "object"
    }
  }
}
