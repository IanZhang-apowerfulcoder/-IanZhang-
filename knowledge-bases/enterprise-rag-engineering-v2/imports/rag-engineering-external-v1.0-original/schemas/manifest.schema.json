{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/knowledge-package/manifest.schema.json",
  "title": "知识库包清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_schema_version",
    "package_id",
    "domain_code",
    "domain_name",
    "package_version",
    "language",
    "created_at",
    "source_policy",
    "files",
    "supported_resource_types",
    "core_knowledge_node_ids",
    "content_readiness",
    "expert_review_status",
    "reviewed_by",
    "reviewed_at"
  ],
  "properties": {
    "package_schema_version": {
      "type": "string",
      "const": "1.1.0"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,99}$"
    },
    "domain_code": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,79}$"
    },
    "domain_name": {
      "type": "string",
      "minLength": 1
    },
    "package_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "language": {
      "type": "string",
      "enum": [
        "zh-CN",
        "en-US",
        "mixed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_policy": {
      "type": "string",
      "enum": [
        "traceable_sources_required",
        "internal_expert_verified"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file_name",
          "sha256",
          "record_count",
          "required"
        ],
        "properties": {
          "file_name": {
            "type": "string",
            "enum": [
              "sources.json",
              "knowledge_nodes.json",
              "knowledge_edges.json",
              "rag_chunks.json",
              "practical_tasks.json",
              "question_bank.json",
              "evaluation_cases.json"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "record_count": {
            "type": "integer",
            "minimum": 0
          },
          "required": {
            "type": "boolean"
          }
        }
      },
      "maxItems": 7
    },
    "supported_resource_types": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "custom_lecture",
          "practical_guide",
          "concept_explanation",
          "worked_example",
          "code_walkthrough",
          "micro_lesson",
          "mixed"
        ]
      }
    },
    "core_knowledge_node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "license_notice": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_readiness": {
      "type": "string",
      "enum": [
        "development_fixture",
        "competition_ready",
        "enterprise_ready"
      ]
    },
    "expert_review_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "expert_reviewed",
        "approved_for_training"
      ]
    },
    "reviewed_by": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "content_readiness": {
            "enum": [
              "competition_ready",
              "enterprise_ready"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "expert_review_status": {
            "const": "approved_for_training"
          },
          "reviewed_by": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
