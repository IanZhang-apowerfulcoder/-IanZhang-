{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "检索响应",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "retrieval_request_id",
    "evidence_items"
  ],
  "properties": {
    "retrieval_request_id": {
      "type": "string",
      "format": "uuid"
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "chunk_id",
          "document_id",
          "content_excerpt",
          "relevance_score"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "format": "uuid"
          },
          "chunk_id": {
            "type": "string",
            "format": "uuid"
          },
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "content_excerpt": {
            "type": "string"
          },
          "relevance_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
