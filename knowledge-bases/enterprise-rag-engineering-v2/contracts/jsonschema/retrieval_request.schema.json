{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "检索请求",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "retrieval_request_id",
    "knowledge_base_version_id",
    "query_text",
    "top_k",
    "filters"
  ],
  "properties": {
    "retrieval_request_id": {
      "type": "string",
      "format": "uuid"
    },
    "knowledge_base_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "query_text": {
      "type": "string"
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "filters": {
      "type": "object"
    }
  }
}
