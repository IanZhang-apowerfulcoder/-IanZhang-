{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "测评生成智能体输出",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "assessment_draft_id",
    "title",
    "assessment_type",
    "instructions",
    "questions",
    "total_score_points",
    "pass_score_points",
    "evidence_ids",
    "confidence"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "format": "uuid"
    },
    "assessment_draft_id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string"
    },
    "assessment_type": {
      "type": "string",
      "enum": [
        "diagnostic",
        "practice",
        "checkpoint",
        "final"
      ]
    },
    "instructions": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "total_score_points": {
      "type": "number",
      "minimum": 0
    },
    "pass_score_points": {
      "type": "number",
      "minimum": 0
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "question_type",
        "stem",
        "options",
        "correct_answer",
        "score_points",
        "scoring_rubric",
        "explanation",
        "evidence_ids"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "format": "uuid"
        },
        "question_type": {
          "type": "string",
          "enum": [
            "single_choice",
            "multiple_choice",
            "true_false",
            "short_answer",
            "code"
          ]
        },
        "stem": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "option_id",
              "option_text"
            ],
            "properties": {
              "option_id": {
                "type": "string",
                "format": "uuid"
              },
              "option_text": {
                "type": "string"
              }
            }
          }
        },
        "correct_answer": {},
        "score_points": {
          "type": "number",
          "minimum": 0
        },
        "scoring_rubric": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explanation": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
