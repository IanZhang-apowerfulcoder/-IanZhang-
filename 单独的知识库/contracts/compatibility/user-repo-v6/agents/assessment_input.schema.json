{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "测评生成智能体输入",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path_plan_proposal_id",
    "path_step_id",
    "profile_snapshot_id",
    "retrieval_evidence_ids",
    "target_knowledge_node_ids",
    "difficulty_level",
    "assessment_type",
    "question_count"
  ],
  "properties": {
    "path_plan_proposal_id": {
      "type": "string",
      "format": "uuid"
    },
    "path_step_id": {
      "type": "string",
      "format": "uuid"
    },
    "profile_snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "retrieval_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "target_knowledge_node_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "difficulty_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "assessment_type": {
      "type": "string",
      "enum": [
        "diagnostic",
        "practice",
        "checkpoint",
        "final"
      ]
    },
    "question_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  }
}
