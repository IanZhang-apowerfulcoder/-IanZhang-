{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "路径规划智能体输入",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnosis_proposal_id",
    "profile_snapshot_id",
    "program_target_node_ids",
    "available_knowledge_node_ids"
  ],
  "properties": {
    "diagnosis_proposal_id": {
      "type": "string",
      "format": "uuid"
    },
    "profile_snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "program_target_node_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "available_knowledge_node_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
