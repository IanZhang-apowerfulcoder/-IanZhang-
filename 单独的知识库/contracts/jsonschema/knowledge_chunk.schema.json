{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Chunk",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "chunk_id",
    "evidence_id",
    "document_id",
    "knowledge_base_version_id",
    "knowledge_node_id",
    "title",
    "content",
    "difficulty_level",
    "source_ids",
    "citation_text"
  ],
  "properties": {
    "chunk_id": {
      "type": "string",
      "format": "uuid"
    },
    "evidence_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "knowledge_base_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "knowledge_node_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "minLength": 30
    },
    "difficulty_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "source_ids": {
      "type": "array",
      "minItems": 1
    },
    "citation_text": {
      "type": "string"
    }
  }
}
