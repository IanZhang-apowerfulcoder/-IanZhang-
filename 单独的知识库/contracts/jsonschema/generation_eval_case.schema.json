{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generation Evaluation Case",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "test_case_id",
    "knowledge_node_id",
    "prompt",
    "expected_key_points",
    "required_evidence_ids",
    "forbidden_claims"
  ],
  "properties": {
    "test_case_id": {
      "type": "string"
    },
    "knowledge_node_id": {
      "type": "string"
    },
    "required_evidence_ids": {
      "type": "array",
      "minItems": 1
    }
  }
}
