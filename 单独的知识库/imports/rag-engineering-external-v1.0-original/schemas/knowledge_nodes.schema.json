{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "知识节点集合",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1.0"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_node_id",
          "node_name",
          "description",
          "importance",
          "difficulty_level"
        ],
        "properties": {
          "knowledge_node_id": {
            "type": "string",
            "minLength": 1
          },
          "node_name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "importance": {
            "type": "string",
            "enum": [
              "core",
              "important",
              "advanced",
              "optional"
            ]
          },
          "difficulty_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "competency_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
