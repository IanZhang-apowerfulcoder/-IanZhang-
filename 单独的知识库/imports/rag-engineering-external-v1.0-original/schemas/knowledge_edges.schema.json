{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "知识关系集合",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1.0"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_edge_id",
          "source_node_id",
          "target_node_id",
          "relation_type"
        ],
        "properties": {
          "knowledge_edge_id": {
            "type": "string"
          },
          "source_node_id": {
            "type": "string"
          },
          "target_node_id": {
            "type": "string"
          },
          "relation_type": {
            "type": "string",
            "enum": [
              "prerequisite",
              "supports",
              "contrast",
              "similar",
              "confused_with",
              "constraint"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
